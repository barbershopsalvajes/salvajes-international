# ─────────────────────────────────────────────────────────────
# RESUELVE INTELLECT — Variables de configuración
# Copia este archivo a .env (local) o defínelas en Netlify:
# Site configuration → Environment variables.
# Las variables PUBLIC_* se incrustan en el HTML (NO poner secretos).
# Las demás solo existen en el servidor (Netlify Functions).
# ─────────────────────────────────────────────────────────────

# ── Públicas (frontend) ──────────────────────────────────────
PUBLIC_SITE_URL=https://resuelveintellect.com
# Número en formato internacional sin "+" ni espacios, p. ej. 34600000000
PUBLIC_WHATSAPP_NUMBER=
PUBLIC_CONTACT_EMAIL=
PUBLIC_INSTAGRAM_URL=
PUBLIC_LINKEDIN_URL=
# Datos legales del titular (Aviso legal, LSSI-CE art. 10)
PUBLIC_LEGAL_NAME=
PUBLIC_LEGAL_ID=
PUBLIC_LEGAL_ADDRESS=
PUBLIC_LEGAL_REGISTRY=
# Anti-spam opcional (Cloudflare Turnstile) — clave pública
PUBLIC_TURNSTILE_SITE_KEY=
# Analítica opcional sin cookies (Plausible). Solo se carga tras consentimiento.
PUBLIC_PLAUSIBLE_DOMAIN=

# ── Privadas (solo servidor) ─────────────────────────────────
# Webhook de Make (escenario "Leads web") — ver docs/INTEGRACIONES.md
MAKE_WEBHOOK_URL=
# Secreto para firmar (HMAC-SHA256) los envíos al webhook: cabecera X-RI-Signature
WEBHOOK_SECRET=
# Token para consultar/exportar leads almacenados: GET /api/leads
ADMIN_TOKEN=
# Clave secreta de Cloudflare Turnstile (si se usa PUBLIC_TURNSTILE_SITE_KEY)
TURNSTILE_SECRET_KEY=
# Demo "Recepcionista inteligente" en modo IA real (si falta → modo simulación)
ANTHROPIC_API_KEY=
# Orígenes permitidos para los formularios (coma). Por defecto, PUBLIC_SITE_URL.
ALLOWED_ORIGINS=
