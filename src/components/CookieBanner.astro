---
import { site } from '../config/site.ts';
import { t, routes, type Lang } from '../i18n/ui.ts';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang).cookies;
const hasAnalytics = Boolean(site.plausibleDomain);
---

<div class="cookie" data-cookie data-analytics-domain={site.plausibleDomain} hidden role="dialog" aria-modal="false" aria-labelledby="cookie-title">
  <div class="cookie-main" data-cookie-main>
    <p id="cookie-title" class="cookie-title">{ui.title}</p>
    <p class="cookie-body">{ui.body} <a href={routes[lang].cookies}>{ui.more}</a></p>
    <div class="cookie-actions">
      <button type="button" class="btn btn--ghost btn--sm" data-cookie-reject>{ui.reject}</button>
      {hasAnalytics && <button type="button" class="btn btn--ghost btn--sm" data-cookie-settings>{ui.settings}</button>}
      <button type="button" class="btn btn--accent btn--sm" data-cookie-accept>{ui.accept}</button>
    </div>
  </div>
  <div class="cookie-prefs" data-cookie-prefs hidden>
    <label class="check"><input type="checkbox" checked disabled /> <span><strong>{ui.necessary}</strong><br />{ui.necessaryD}</span></label>
    {hasAnalytics && <label class="check"><input type="checkbox" data-cookie-analytics /> <span><strong>{ui.analytics}</strong><br />{ui.analyticsD}</span></label>}
    <button type="button" class="btn btn--accent btn--sm" data-cookie-save>{ui.save}</button>
  </div>
</div>

<style>
  .cookie {
    position: fixed;
    z-index: 200;
    left: 16px;
    bottom: calc(16px + env(safe-area-inset-bottom));
    width: min(380px, calc(100% - 32px));
    padding: 18px;
    border-radius: 20px;
    background: rgba(19, 20, 24, 0.92);
    border: 1px solid var(--line-2);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    box-shadow: var(--shadow);
    animation: c-in 0.6s var(--ease);
  }
  .cookie[hidden] {
    display: none;
  }
  .cookie-title {
    font-weight: 600;
    margin-bottom: 6px;
  }
  .cookie-body {
    font-size: 13px;
    color: var(--muted);
  }
  .cookie-body a {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .cookie-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }
  .cookie-actions .btn {
    flex: 1;
  }
  .cookie-prefs {
    display: grid;
    gap: 14px;
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  .cookie-prefs[hidden] {
    display: none;
  }
  @keyframes c-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
  }
</style>
