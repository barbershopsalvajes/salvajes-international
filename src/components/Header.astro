---
import Logo from './ui/Logo.astro';
import Icon from './ui/Icon.astro';
import { t, routes, type Lang } from '../i18n/ui.ts';

interface Props {
  lang: Lang;
  alternate: { es: string; en: string };
}
const { lang, alternate } = Astro.props;
const ui = t(lang);
const home = routes[lang].home;
const links = [
  { href: `${home}#servicios`, label: ui.nav.services },
  { href: `${home}#demos`, label: ui.nav.demos },
  { href: `${home}#sectores`, label: ui.nav.sectors },
  { href: `${home}#metodo`, label: ui.nav.process },
  { href: `${home}#calculadora`, label: ui.nav.calculator },
  { href: `${home}#contacto`, label: ui.nav.contact },
];
---

<header class="nav" data-nav>
  <div class="container nav-inner">
    <a href={home} class="nav-logo" aria-label={ui.a11y.home}><Logo /></a>

    <nav class="nav-links" aria-label="Principal">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <div class="nav-actions">
      <div class="lang" role="group" aria-label={ui.a11y.langSwitch}>
        <a href={alternate.es} hreflang="es" lang="es" aria-current={lang === 'es' ? 'true' : undefined} data-lang-link="es">ES</a>
        <a href={alternate.en} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined} data-lang-link="en">EN</a>
      </div>
      <a href={`${home}#contacto`} class="btn btn--accent btn--sm nav-cta" data-cta="nav">{ui.nav.cta}</a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-nav-toggle>
        <span class="sr-only" data-label-open>{ui.a11y.menu}</span>
        <span class="sr-only" data-label-close hidden>{ui.a11y.close}</span>
        <span class="burger" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
    <nav aria-label="Móvil">
      <ul>
        {
          links.map((l, i) => (
            <li style={`--i:${i}`}>
              <a href={l.href} data-close-menu>
                <span class="mm-index">0{i + 1}</span>
                {l.label}
                <Icon name="arrow" size={20} />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="mm-foot">
      <a href={`${home}#contacto`} class="btn btn--accent btn--block" data-close-menu>{ui.nav.cta}</a>
      <p class="mm-slogan">{ui.hero.slogan}</p>
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    height: var(--nav-h);
    transition: background 0.4s, border-color 0.4s, backdrop-filter 0.4s;
    border-bottom: 1px solid transparent;
  }
  .nav.is-scrolled,
  .nav.is-open {
    background: rgba(6, 6, 7, 0.72);
    backdrop-filter: saturate(160%) blur(18px);
    -webkit-backdrop-filter: saturate(160%) blur(18px);
    border-bottom-color: var(--line);
  }
  .nav-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .nav-logo {
    display: flex;
    align-items: center;
    flex: none;
  }
  .nav-links ul {
    display: flex;
    gap: 4px;
  }
  .nav-links a {
    display: block;
    padding: 8px 13px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
    transition: color 0.2s, background 0.2s;
  }
  .nav-links a:hover {
    color: var(--text);
    background: rgba(255, 255, 255, 0.06);
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .lang {
    display: flex;
    padding: 3px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: rgba(255, 255, 255, 0.03);
  }
  .lang a {
    padding: 5px 10px;
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--muted);
    transition: background 0.2s, color 0.2s;
  }
  .lang a[aria-current='true'] {
    background: var(--text);
    color: var(--ink);
  }
  .lang a:not([aria-current='true']):hover {
    color: var(--text);
  }
  .nav-toggle {
    display: none;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    border: 1px solid var(--line-2);
    background: rgba(255, 255, 255, 0.04);
    place-items: center;
  }
  .burger {
    position: relative;
    display: block;
    width: 18px;
    height: 10px;
  }
  .burger span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.6px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.4s var(--ease), top 0.4s var(--ease);
  }
  .burger span:first-child {
    top: 0;
  }
  .burger span:last-child {
    top: 8.4px;
  }
  .nav.is-open .burger span:first-child {
    top: 4.2px;
    transform: rotate(45deg);
  }
  .nav.is-open .burger span:last-child {
    top: 4.2px;
    transform: rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: var(--nav-h) 0 0 0;
    background: rgba(6, 6, 7, 0.97);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    padding: 24px var(--gutter) calc(32px + env(safe-area-inset-bottom));
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow-y: auto;
  }
  .mobile-menu[hidden] {
    display: none;
  }
  .mobile-menu li {
    border-bottom: 1px solid var(--line);
    opacity: 0;
    transform: translateY(14px);
    animation: mm-in 0.6s var(--ease) forwards;
    animation-delay: calc(var(--i) * 50ms + 60ms);
  }
  .mobile-menu li a {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px 0;
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .mobile-menu li a :global(svg) {
    margin-left: auto;
    color: var(--muted-2);
  }
  .mm-index {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--accent);
    font-weight: 500;
    letter-spacing: 0;
  }
  .mm-foot {
    display: grid;
    gap: 18px;
    margin-top: 32px;
  }
  .mm-slogan {
    text-align: center;
    color: var(--muted-2);
    font-size: 14px;
  }
  @keyframes mm-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 1080px) {
    .nav-links {
      display: none;
    }
    .nav-toggle {
      display: grid;
    }
  }
  @media (max-width: 560px) {
    .nav-cta {
      display: none;
    }
    .nav :global(.logo-word) {
      font-size: 12.5px;
      gap: 5px;
      letter-spacing: 0.12em;
    }
    .nav-inner {
      gap: 10px;
    }
  }
  @media (max-width: 360px) {
    .nav :global(.logo-b) {
      display: none;
    }
  }
</style>
