---
import Icon from '../ui/Icon.astro';
import { t, type Lang } from '../../i18n/ui.ts';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang).demos;
const ui = d.admin;
const columns = lang === 'es'
  ? [
      { type: 'invoice', name: 'Finanzas', seed: ['Factura F-2024-097 · aprobada'] },
      { type: 'incident', name: 'Operaciones', seed: ['Impresora oficina 2 · resuelta'] },
      { type: 'quote', name: 'Comercial', seed: ['Presupuesto evento 40 pax · enviado'] },
      { type: 'hr', name: 'RR. HH.', seed: ['Alta nuevo empleado · en curso'] },
    ]
  : [
      { type: 'invoice', name: 'Finance', seed: ['Invoice F-2024-097 · approved'] },
      { type: 'incident', name: 'Operations', seed: ['Office 2 printer · resolved'] },
      { type: 'quote', name: 'Sales', seed: ['Event quote 40 pax · sent'] },
      { type: 'hr', name: 'HR', seed: ['New hire onboarding · in progress'] },
    ];
const strings = { lang, ...ui };
---

<div class="demo admin" data-admin data-strings={JSON.stringify(strings)}>
  <div class="demo-head">
    <div>
      <h3>{ui.title}</h3>
      <p>{ui.intro}</p>
    </div>
    <span class="chip chip--sim"><span class="dot"></span>{d.simBadge}</span>
  </div>

  <div class="admin-grid">
    <div class="panel admin-input">
      <p class="panel-title">{ui.samples}</p>
      <div class="samples">
        {ui.sampleList.map((smp, i) => <button type="button" class="sample" data-sample={i}>{smp.slice(0, 54)}…</button>)}
      </div>
      <label class="sr-only" for="admin-text">{ui.placeholder}</label>
      <textarea id="admin-text" class="textarea" rows="5" maxlength="2000" placeholder={ui.placeholder} data-admin-text>{ui.sampleList[0]}</textarea>
      <button type="button" class="btn btn--accent btn--block" data-admin-run>{ui.run}<Icon name="arrow" /></button>
      <ol class="stepper" data-admin-steps aria-label="Progreso">
        {ui.steps.map((st) => <li><span></span>{st}</li>)}
      </ol>
    </div>

    <div class="admin-out" data-admin-out>
      <div class="panel result" data-admin-result hidden>
        <div class="result-top">
          <div>
            <p class="panel-title">{ui.type}</p>
            <p class="result-type" data-r-type></p>
          </div>
          <span class="badge" data-r-prio></span>
        </div>
        <dl class="kv">
          <dt>{ui.dept}</dt><dd data-r-dept></dd>
          <dt>{ui.priority}</dt><dd data-r-prio-text></dd>
          <dt>ID</dt><dd data-r-id></dd>
        </dl>
        <div class="conf"><div class="meter"><span data-r-conf></span></div><span class="conf-n" data-r-conf-n></span></div>
        <p class="panel-title" style="margin-top:18px">{ui.entities}</p>
        <ul class="entities" data-r-ents></ul>
      </div>

      <div class="panel">
        <p class="panel-title">{ui.board}</p>
        <div class="board" data-admin-board>
          {
            columns.map((c) => (
              <div class="col" data-col={c.type}>
                <p class="col-h">{c.name}</p>
                {c.seed.map((x) => <div class="ticket ticket--old">{x}</div>)}
              </div>
            ))
          }
        </div>
      </div>

      <div class="panel report" data-admin-report hidden>
        <div class="report-top">
          <p class="panel-title">{ui.report}</p>
          <button type="button" class="btn btn--ghost btn--sm" data-admin-dl><Icon name="download" size={16} />{ui.download}</button>
        </div>
        <pre class="code" data-r-report></pre>
      </div>
    </div>
  </div>
  <p class="demo-note"><Icon name="shield" size={16} />{d.simNote}</p>
</div>

<script>
  import { initAdmin } from '../../scripts/demo-admin.ts';
  document.querySelectorAll<HTMLElement>('[data-admin]').forEach(initAdmin);
</script>

<style>
  .admin-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 24px;
    align-items: start;
  }
  .admin-input {
    display: grid;
    gap: 14px;
  }
  .samples {
    display: grid;
    gap: 8px;
  }
  .sample {
    text-align: left;
    padding: 10px 12px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.02);
    color: var(--muted);
    font-size: 13px;
    line-height: 1.4;
    transition: border-color 0.2s, color 0.2s;
  }
  .sample:hover,
  .sample[aria-pressed='true'] {
    border-color: rgba(255, 90, 31, 0.5);
    color: var(--text);
  }
  .stepper {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
  }
  .stepper li {
    display: grid;
    gap: 8px;
    font-size: 12px;
    color: var(--muted-2);
    text-align: center;
  }
  .stepper li span {
    height: 4px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.1);
    transition: background 0.4s;
  }
  .stepper li.is-done {
    color: var(--text);
  }
  .stepper li.is-done span {
    background: var(--accent);
  }
  .admin-out {
    display: grid;
    gap: 16px;
  }
  .result[hidden],
  .report[hidden] {
    display: none;
  }
  .result,
  .report {
    animation: demo-pop 0.5s var(--ease) both;
  }
  .result-top,
  .report-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 14px;
  }
  .result-type {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .conf {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 14px;
  }
  .conf .meter {
    flex: 1;
  }
  .conf-n {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted);
  }
  .entities {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .entities :global(li) {
    padding: 6px 10px;
    border-radius: 10px;
    border: 1px solid var(--line-2);
    font-size: 13px;
  }
  .entities :global(li b) {
    color: var(--muted-2);
    font-weight: 500;
    margin-right: 6px;
  }
  .board {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
  }
  .col {
    display: grid;
    align-content: start;
    gap: 8px;
    min-height: 130px;
    padding: 10px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.025);
    border: 1px dashed var(--line-2);
    transition: border-color 0.4s, background 0.4s;
  }
  .col.is-target {
    border-color: var(--accent);
    background: rgba(255, 90, 31, 0.06);
  }
  .col-h {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-2);
  }
  .ticket {
    padding: 9px 10px;
    border-radius: 10px;
    background: #16181c;
    border: 1px solid var(--line);
    font-size: 12.5px;
    line-height: 1.35;
  }
  .ticket--old {
    opacity: 0.45;
  }
  .ticket :global(.badge) {
    margin-top: 6px;
    font-size: 10.5px;
    padding: 2px 8px;
  }
  :global(.ticket--new) {
    border-color: rgba(255, 90, 31, 0.6) !important;
    box-shadow: 0 0 24px rgba(255, 90, 31, 0.18);
    animation: drop 0.7s var(--ease) both;
  }
  @keyframes drop {
    from {
      opacity: 0;
      transform: translateY(-24px) scale(0.95);
    }
  }
  @media (max-width: 960px) {
    .admin-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .board {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
