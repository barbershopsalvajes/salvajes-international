---
import Base from '../layouts/Base.astro';
import Icon from '../components/ui/Icon.astro';
import { t } from '../i18n/ui.ts';
const es = t('es').notFound;
const en = t('en').notFound;
---

<Base lang="es" title="404 · RESUELVE INTELLECT" description={es.body} alternate={{ es: '/', en: '/en/' }} noindex>
  <section class="page-hero nf">
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="container">
      <p class="nf-code gradient-text">404</p>
      <h1 class="h2">{es.title}</h1>
      <p class="lead" style="margin-top:18px">{es.body}</p>
      <p class="muted" lang="en" style="margin-top:8px">{en.title} {en.body}</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:36px">
        <a class="btn btn--accent" href="/">{es.cta}<Icon name="arrow" /></a>
        <a class="btn btn--ghost" href="/en/" lang="en">{en.cta}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: 80svh;
  }
  .nf-code {
    font-size: clamp(100px, 20vw, 240px);
    font-weight: 700;
    letter-spacing: -0.06em;
    line-height: 0.9;
    margin-bottom: 24px;
  }
</style>
